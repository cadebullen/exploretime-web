# Copy this file to .env.local and fill in your own keys.
# .env.local is git-ignored — never commit real keys.

# Google Places API (city autocomplete) — https://console.cloud.google.com/apis/library/places-backend.googleapis.com
PLACES_KEY=

# WeatherAPI.com (current weather + forecast) — https://www.weatherapi.com/
WEATHER_API_KEY=

# FXRatesAPI (currency conversion) — https://fxratesapi.com/
FXRATES_CURRENCY_CONVERTOR_API_KEY=
